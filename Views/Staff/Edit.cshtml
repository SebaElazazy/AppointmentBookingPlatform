@model AppointmentsManagementSystem.Models.Staff
@{
      Layout = User.IsInRole("Admin") ? "_AdminLayout" : "_Layout";
    ViewData["Title"] = "Edit staff";
    var services = (List<AppointmentsManagementSystem.Models.Service>)ViewBag.Services;
    var selected = (List<int>)ViewBag.SelectedServices;
}

<a asp-action="Index" class="back-link">&larr; Back to staff</a>

<div class="page-header">
    <div>
        <h1>Edit staff</h1>
        <p>Update this staff member's details.</p>
    </div>
</div>

<div class="form-card">
    <form asp-action="Edit" enctype="multipart/form-data">
        <input type="hidden" asp-for="Id" />
        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

        <div class="mb-3">
            <label class="form-label">Account</label>
            <select name="UserId" class="form-select" asp-items="ViewBag.UserId"></select>
            <span asp-validation-for="UserId" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Specialization" class="form-label"></label>
            <input asp-for="Specialization" class="form-control" />
            <span asp-validation-for="Specialization" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label class="form-label">Photo</label>
            @if (!string.IsNullOrEmpty(Model.ImageUrl))
            {
                <img src="@Model.ImageUrl" class="img-preview-current" style="border-radius:50%;" alt="" />
            }
            <input type="file" name="ImageFile" class="form-control mt-2" accept="image/*" />
        </div>

        <hr />

        <div class="form-section-title">Services provided</div>
        <div class="chip-list">
            @foreach (var service in services)
            {
                var isChecked = selected.Contains(service.Id);
                <div class="chip-check">
                    <input type="checkbox" id="svc-@service.Id" name="selectedServices" value="@service.Id" checked="@isChecked" />
                    <label for="svc-@service.Id">@service.Name</label>
                </div>
            }
        </div>

        <div class="form-actions">
            <button type="submit" class="btn btn-primary">Save changes</button>
            <a asp-action="Index" class="btn btn-secondary">Cancel</a>
        </div>
    </form>
</div>
