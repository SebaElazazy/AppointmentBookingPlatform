@model AppointmentsManagementSystem.Models.Staff
@{
    ViewData["Title"] = "Add staff";
    var services = (List<AppointmentsManagementSystem.Models.Service>)ViewBag.Services;
}

<a asp-action="Index" class="back-link">&larr; Back to staff</a>

<div class="page-header">
    <div>
        <h1>Add staff</h1>
        <p>Link an existing account to a staff profile.</p>
    </div>
</div>

<div class="form-card">
    <form asp-action="Create" enctype="multipart/form-data">
        <div asp-validation-summary="All" class="alert alert-danger" role="alert"></div>

        <div class="mb-3">
            <label class="form-label">Account</label>
            <select name="UserId" class="form-select" asp-items="ViewBag.UserId">
                <option value="">-- Select an existing user --</option>
            </select>
            <span asp-validation-for="UserId" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Specialization" class="form-label"></label>
            <input asp-for="Specialization" class="form-control" placeholder="e.g. Hair Stylist" />
            <span asp-validation-for="Specialization" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label class="form-label">Photo</label>
            <input type="file" name="ImageFile" class="form-control" accept="image/*" />
        </div>

        <hr />

        <div class="form-section-title">Services provided</div>
        <div class="chip-list">
            @foreach (var service in services)
            {
                <div class="chip-check">
                    <input type="checkbox" id="svc-@service.Id" name="selectedServices" value="@service.Id" />
                    <label for="svc-@service.Id">@service.Name</label>
                </div>
            }
        </div>

        <div class="form-actions">
            <button type="submit" class="btn btn-primary">Save staff member</button>
            <a asp-action="Index" class="btn btn-secondary">Cancel</a>
        </div>
    </form>
</div>
