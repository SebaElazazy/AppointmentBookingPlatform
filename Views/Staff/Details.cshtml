@model AppointmentsManagementSystem.Models.Staff
@{
      Layout = User.IsInRole("Admin") ? "_AdminLayout" : "_Layout";
    ViewData["Title"] = "Staff details";
}

<a asp-action="Index" class="back-link">&larr; Back to staff</a>

<div class="page-header">
    <div>
        <h1>@Model.User?.FullName</h1>
        <p>@Model.Specialization</p>
    </div>
</div>

<div class="detail-card">
    @if (!string.IsNullOrEmpty(Model.ImageUrl))
    {
        <img src="@Model.ImageUrl" style="width:84px;height:84px;object-fit:cover;border-radius:50%;margin-bottom:20px;" alt="" />
    }
    <div class="detail-row"><span class="k">Email</span><span class="v">@Model.User?.Email</span></div>
    <div class="detail-row"><span class="k">Specialization</span><span class="v">@Model.Specialization</span></div>

    @if (Model.StaffServices != null && Model.StaffServices.Any())
    {
        <div class="detail-row">
            <span class="k">Services</span>
            <span class="v">@string.Join(", ", Model.StaffServices.Select(ss => ss.Service?.Name))</span>
        </div>
    }

    @if (User.IsInRole("Admin"))
    {
        <div class="form-actions">
            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">Edit</a>
            <a asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-secondary" style="color:var(--danger) !important;">Delete</a>
        </div>
    }
</div>
