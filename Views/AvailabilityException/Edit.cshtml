@model AppointmentsManagementSystem.Models.AvailabilityException
@{
    ViewData["Title"] = "Edit exception";
}

<a asp-action="Index" class="back-link">&larr; Back to exceptions</a>

<div class="page-header">
    <div><h1>Edit exception</h1></div>
</div>

<div class="form-card">
    <form asp-action="Edit">
        <input type="hidden" asp-for="Id" />
        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

        <div class="mb-3">
            <label class="form-label">Staff member</label>
            <select name="StaffId" class="form-select" asp-items="ViewBag.StaffId"></select>
            <span asp-validation-for="StaffId" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Date" class="form-label"></label>
            <input asp-for="Date" type="date" class="form-control" asp-format="{0:yyyy-MM-dd}" />
            <span asp-validation-for="Date" class="text-danger"></span>
        </div>

        <div class="form-check mb-3">
            <input asp-for="IsDayOff" class="form-check-input" />
            <label asp-for="IsDayOff" class="form-check-label">Mark as a full day off</label>
        </div>

        <div class="row">
            <div class="col-md-6 mb-3">
                <label asp-for="StartTime" class="form-label">Start time (if working)</label>
                <input asp-for="StartTime" type="time" class="form-control" />
                <span asp-validation-for="StartTime" class="text-danger"></span>
            </div>
            <div class="col-md-6 mb-3">
                <label asp-for="EndTime" class="form-label">End time (if working)</label>
                <input asp-for="EndTime" type="time" class="form-control" />
                <span asp-validation-for="EndTime" class="text-danger"></span>
            </div>
        </div>

        <div class="form-actions">
            <button type="submit" class="btn btn-primary">Save changes</button>
            <a asp-action="Index" class="btn btn-secondary">Cancel</a>
        </div>
    </form>
</div>
