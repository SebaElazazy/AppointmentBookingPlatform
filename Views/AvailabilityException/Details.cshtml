@model AppointmentsManagementSystem.Models.AvailabilityException
@{
    ViewData["Title"] = "Exception details";
}

<a asp-action="Index" class="back-link">&larr; Back to exceptions</a>

<div class="page-header">
    <div><h1>@(Model.Staff?.User?.FullName ?? "Staff") &mdash; @Model.Date.ToString("MMM d, yyyy")</h1></div>
</div>

<div class="detail-card">
    <div class="detail-row"><span class="k">Staff</span><span class="v">@Model.Staff?.User?.FullName</span></div>
    <div class="detail-row"><span class="k">Date</span><span class="v">@Model.Date.ToString("MMM d, yyyy")</span></div>
    <div class="detail-row">
        <span class="k">Status</span>
        <span class="v">
            @if (Model.IsDayOff)
            {
                <span class="badge-status status-cancelled">Day off</span>
            }
            else
            {
                <span class="badge-status status-pending">@Model.StartTime?.ToString(@"hh\:mm") &ndash; @Model.EndTime?.ToString(@"hh\:mm")</span>
            }
        </span>
    </div>

    @if (User.IsInRole("Admin"))
    {
        <div class="form-actions">
            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">Edit</a>
            <a asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-secondary" style="color:var(--danger) !important;">Delete</a>
        </div>
    }
</div>
