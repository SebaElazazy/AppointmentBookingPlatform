@model IEnumerable<AppointmentsManagementSystem.Models.AvailabilityException>
@{
    ViewData["Title"] = "Availability Exceptions";
}

<div class="page-header">
    <div>
        <h1>Availability exceptions</h1>
        <p>One-off changes to a staff member's regular schedule &mdash; a day off, or different hours.</p>
    </div>
    @if (User.IsInRole("Admin"))
    {
        <a asp-action="Create" class="action-btn">+ Add exception</a>
    }
</div>

@if (!Model.Any())
{
    <div class="admin-card">
        <div class="empty-state">
            <div class="icon-badge">
                <svg viewBox="0 0 24 24"><rect x="3.5" y="4.5" width="17" height="16" rx="2" /><path d="M3.5 9.5h17M8 3v3M16 3v3" /></svg>
            </div>
            <h3>No exceptions yet</h3>
            <p>Mark a day off or adjust hours for a specific date.</p>
            @if (User.IsInRole("Admin"))
            {
                <a asp-action="Create" class="action-btn">+ Add exception</a>
            }
        </div>
    </div>
}
else
{
    <div class="admin-card">
        <table class="admin-table">
            <thead>
                <tr>
                    <th>Staff</th>
                    <th>Date</th>
                    <th>Status</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>
                            <div class="cell-primary">
                                <div class="avatar-chip">@(item.Staff?.User?.FullName?.Substring(0, 1) ?? "?")</div>
                                <div class="t"><strong>@item.Staff?.User?.FullName</strong></div>
                            </div>
                        </td>
                        <td>@item.Date.ToString("MMM d, yyyy")</td>
                        <td>
                            @if (item.IsDayOff)
                            {
                                <span class="badge-status status-cancelled">Day off</span>
                            }
                            else
                            {
                                <span class="badge-status status-pending">@item.StartTime?.ToString(@"hh\:mm") &ndash; @item.EndTime?.ToString(@"hh\:mm")</span>
                            }
                        </td>
                        <td>
                            <div class="action-links">
                                <a asp-action="Details" asp-route-id="@item.Id">Details</a>
                                @if (User.IsInRole("Admin"))
                                {
                                    <a asp-action="Edit" asp-route-id="@item.Id">Edit</a>
                                    <a asp-action="Delete" asp-route-id="@item.Id" class="danger">Delete</a>
                                }
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
