@model AppointmentsManagementSystem.Models.AvailabilityException
@{
    ViewData["Title"] = "Delete exception";
}

<a asp-action="Index" class="back-link">&larr; Back to exceptions</a>

<div class="delete-card">
    <div class="warn-icon">
        <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M12 9v4M12 17h.01M10.3 3.9L2.7 17.3a2 2 0 001.7 3h15.2a2 2 0 001.7-3L13.7 3.9a2 2 0 00-3.4 0z" /></svg>
    </div>
    <h2>Remove this exception?</h2>
    <p style="color:var(--ink-soft); margin:10px 0 22px;">
        @Model.Staff?.User?.FullName will go back to their regular schedule on @Model.Date.ToString("MMM d, yyyy").
    </p>

    <form asp-action="Delete">
        <input type="hidden" asp-for="Id" />
        <div class="form-actions">
            <button type="submit" class="btn btn-danger">Yes, remove</button>
            <a asp-action="Index" class="btn btn-secondary">Cancel</a>
        </div>
    </form>
</div>
