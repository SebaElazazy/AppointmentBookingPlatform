@using AppointmentsManagementSystem.Models
@{
    ViewData["Title"] = "Dashboard";
    Layout = "_AdminLayout";
}

<style>
    /* تنسيقات خاصة بعناصر الداشبورد فقط */
    .welcome-banner {
        background: linear-gradient(135deg, #f4a742, #f47c42);
        border-radius: 12px;
        color: white;
        padding: 25px;
    }
    .quick-card {
        background: white;
        border-radius: 10px;
        text-align: center;
        padding: 20px 10px;
        box-shadow: 0 1px 4px rgba(0,0,0,0.08);
        text-decoration: none;
        color: #333;
        display: block;
        transition: 0.2s;
    }
    .quick-card:hover {
        transform: translateY(-3px);
        box-shadow: 0 4px 10px rgba(0,0,0,0.12);
        color: #0b2447;
    }
    .quick-card i {
        font-size: 28px;
        color: #0b2447;
        margin-bottom: 8px;
    }
    .stat-card {
        background: white;
        border-radius: 10px;
        padding: 20px;
        box-shadow: 0 1px 4px rgba(0,0,0,0.08);
        text-align: center;
    }
    .stat-number {
        font-size: 28px;
        font-weight: bold;
        color: #0b2447;
    }
    .panel {
        background: white;
        border-radius: 10px;
        padding: 20px;
        box-shadow: 0 1px 4px rgba(0,0,0,0.08);
    }
</style>

<!-- Welcome banner -->
<div class="welcome-banner mb-4">
    <h4>Welcome, Admin</h4>
    <p class="mb-0">Here's what's happening in your business today.</p>
</div>

<!-- Quick actions -->
<div class="row mb-4">
    <div class="col">
        <a href="/Services/Create" class="quick-card">
            <i class="bi bi-plus-circle"></i>
            <div>Add Service</div>
        </a>
    </div>
    <div class="col">
        <a href="/Staff/Create" class="quick-card">
            <i class="bi bi-person-plus"></i>
            <div>Add Staff</div>
        </a>
    </div>
    <div class="col">
        <a href="/WorkingHour/Create" class="quick-card">
            <i class="bi bi-clock"></i>
            <div>Add Working Hours</div>
        </a>
    </div>
    <div class="col">
        <a href="/AvailabilityException/Create" class="quick-card">
            <i class="bi bi-calendar-x"></i>
            <div>Add Exception</div>
        </a>
    </div>
    <div class="col">
        <a href="/Appointment" class="quick-card">
            <i class="bi bi-calendar-check"></i>
            <div>View Bookings</div>
        </a>
    </div>
</div>

<div class="row">
    <!-- Recent appointments -->
    <div class="col-md-6 mb-4">
        <div class="panel h-100">
            <h6 class="mb-3">Recent Appointments</h6>
            @if (ViewBag.RecentAppointments != null)
            {
                foreach (var appt in (List<Appointment>)ViewBag.RecentAppointments)
                {
                    <div class="d-flex justify-content-between border-bottom py-2">
                        <div>
                            <strong>@appt.Customer?.FullName</strong><br />
                            <small class="text-muted">@appt.Service?.Name with @appt.Staff?.User?.FullName</small>
                        </div>
                        <span class="badge bg-secondary align-self-center">@appt.Status</span>
                    </div>
                }
            }
            else
            {
                <p class="text-muted">No recent appointments.</p>
            }
        </div>
    </div>

    <!-- Summary -->
    <div class="col-md-6 mb-4">
        <div class="panel h-100">
            <h6 class="mb-3">Summary</h6>
            <div class="row text-center mb-4">
                <div class="col">
                    <div class="stat-number">@(ViewBag.TotalCustomers ?? 0)</div>
                    <small>Total Users</small>
                </div>
                <div class="col">
                    <div class="stat-number">@(ViewBag.TotalStaff ?? 0)</div>
                    <small>Total Staff</small>
                </div>
                <div class="col">
                    <div class="stat-number">@(ViewBag.TotalServices ?? 0)</div>
                    <small>Total Services</small>
                </div>
            </div>
            <canvas id="bookingChart" style="max-height: 220px;"></canvas>
        </div>
    </div>
</div>

<!-- نقلنا مكتبة Chart.js لسكشن الـ Scripts عشان تشتغل صح مع الـ Layout -->
@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/4.4.0/chart.umd.min.js"></script>
    <script>
        const ctx = document.getElementById('bookingChart');
        if (ctx) {
            new Chart(ctx, {
                type: 'doughnut',
                data: {
                    labels: ['Pending', 'Confirmed', 'Completed', 'Cancelled'],
                    datasets: [{
                        data: [
                            @(ViewBag.PendingCount ?? 0),
                            @(ViewBag.ConfirmedCount ?? 0),
                            @(ViewBag.CompletedCount ?? 0),
                            @(ViewBag.CancelledCount ?? 0)
                        ],
                        backgroundColor: ['#f4a742', '#3b82f6', '#22c55e', '#ef4444']
                    }]
                },
                options: {
                    plugins: {
                        legend: { position: 'bottom' }
                    }
                }
            });
        }
    </script>
}