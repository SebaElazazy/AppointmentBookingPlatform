@model AppointmentsManagementSystem.Models.Appointment
@{
    Layout = User.IsInRole("Admin") ? "_AdminLayout" : "_Layout";
    ViewData["Title"] = "Appointment details";
}

<a asp-action="Index" class="back-link">&larr; Back to appointments</a>

<div class="page-header">
    <div><h1>@Model.Service?.Name</h1></div>
</div>

<div class="detail-card">
    <div class="detail-row"><span class="k">Customer</span><span class="v">@Model.Customer?.FullName</span></div>
    <div class="detail-row"><span class="k">Staff</span><span class="v">@Model.Staff?.User?.FullName</span></div>
    <div class="detail-row"><span class="k">Date</span><span class="v">@Model.AppointmentDate.ToString("MMM d, yyyy")</span></div>
    <div class="detail-row"><span class="k">Time</span><span class="v">@Model.StartTime.ToString(@"hh\:mm") &ndash; @Model.EndTime.ToString(@"hh\:mm")</span></div>
    <div class="detail-row">
        <span class="k">Status</span>
        <span class="v"><span class="badge-status status-@Model.Status.ToString().ToLower()">@Model.Status</span></span>
    </div>

    @if (User.IsInRole("Admin"))
    {
        <div class="form-actions">
            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">Edit</a>
            <a asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-secondary" style="color:var(--danger) !important;">Cancel appointment</a>
        </div>
    }
</div>
