@model AppointmentsManagementSystem.Models.Appointment
@{
    Layout = User.IsInRole("Admin") ? "_AdminLayout" : "_Layout";
    ViewData["Title"] = "Edit appointment";
}

<a asp-action="Index" class="back-link">&larr; Back to appointments</a>

<div class="page-header">
    <div><h1>Edit appointment</h1></div>
</div>

<div class="form-card">
    <form asp-action="Edit">
        <input type="hidden" asp-for="Id" />
        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

        <div class="mb-3">
            <label class="form-label">Customer</label>
            <select name="CustomerId" class="form-select" asp-items="ViewBag.CustomerId"></select>
            <span asp-validation-for="CustomerId" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label class="form-label">Service</label>
            <select name="ServiceId" class="form-select" asp-items="ViewBag.ServiceId"></select>
            <span asp-validation-for="ServiceId" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label class="form-label">Staff member</label>
            <select name="StaffId" class="form-select" asp-items="ViewBag.StaffId"></select>
            <span asp-validation-for="StaffId" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="AppointmentDate" class="form-label">Date</label>
            <input asp-for="AppointmentDate" type="date" class="form-control" asp-format="{0:yyyy-MM-dd}" />
            <span asp-validation-for="AppointmentDate" class="text-danger"></span>
        </div>

        <div class="row">
            <div class="col-md-6 mb-3">
                <label asp-for="StartTime" class="form-label">Start time</label>
                <input asp-for="StartTime" type="time" class="form-control" />
                <span asp-validation-for="StartTime" class="text-danger"></span>
            </div>
            <div class="col-md-6 mb-3">
                <label asp-for="EndTime" class="form-label">End time</label>
                <input asp-for="EndTime" type="time" class="form-control" />
                <span asp-validation-for="EndTime" class="text-danger"></span>
            </div>
        </div>

        <div class="mb-3">
            <label asp-for="Status" class="form-label"></label>
            <select asp-for="Status" class="form-select" asp-items="Html.GetEnumSelectList<AppointmentsManagementSystem.Models.AppointmentStatus>()"></select>
            <span asp-validation-for="Status" class="text-danger"></span>
        </div>

        <div class="form-actions">
            <button type="submit" class="btn btn-primary">Save changes</button>
            <a asp-action="Index" class="btn btn-secondary">Cancel</a>
        </div>
    </form>
</div>
