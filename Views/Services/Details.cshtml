@model AppointmentsManagementSystem.Models.Service
@{
    Layout = User.IsInRole("Admin") ? "_AdminLayout" : "_Layout";
    ViewData["Title"] = "Service details";
}

<a asp-action="Index" class="back-link">&larr; Back to services</a>

<div class="page-header">
    <div>
        <h1>@Model.Name</h1>
        <p>@Model.Description</p>
    </div>
</div>

<div class="detail-card">
    @if (!string.IsNullOrEmpty(Model.ImageUrl))
    {
        <img src="@Model.ImageUrl" style="width:100%;max-height:220px;object-fit:cover;border-radius:10px;margin-bottom:20px;" alt="" />
    }
    <div class="detail-row"><span class="k">Price</span><span class="v">@Model.Price.ToString("0") EGP</span></div>
    <div class="detail-row"><span class="k">Duration</span><span class="v">@Model.DurationMinutes minutes</span></div>
    <div class="detail-row">
        <span class="k">Status</span>
        <span class="v">
            <span class="badge-status @(Model.IsActive ? "status-active" : "status-inactive")">
                @(Model.IsActive ? "Active" : "Inactive")
            </span>
        </span>
    </div>

    @if (User.IsInRole("Admin"))
    {
        <div class="form-actions">
            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">Edit</a>
            <a asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-secondary" style="color:var(--danger) !important;">Delete</a>
        </div>
    }
</div>
