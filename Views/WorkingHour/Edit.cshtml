@model AppointmentsManagementSystem.Models.WorkingHour
@{
    ViewData["Title"] = "Edit working hours";
}

<a asp-action="Index" class="back-link">&larr; Back to working hours</a>

<div class="page-header">
    <div>
        <h1>Edit working hours</h1>
    </div>
</div>

<div class="form-card">
    <form asp-action="Edit">
        <input type="hidden" asp-for="Id" />
        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

        <div class="mb-3">
            <label class="form-label">Staff member</label>
            <select name="StaffId" class="form-select" asp-items="ViewBag.StaffId"></select>
            <span asp-validation-for="StaffId" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="DayOfWeek" class="form-label">Day of week</label>
            <select asp-for="DayOfWeek" class="form-select" asp-items="Html.GetEnumSelectList<DayOfWeek>()"></select>
            <span asp-validation-for="DayOfWeek" class="text-danger"></span>
        </div>

        <div class="row">
            <div class="col-md-6 mb-3">
                <label asp-for="StartTime" class="form-label">Start time</label>
                <input asp-for="StartTime" type="time" class="form-control" />
                <span asp-validation-for="StartTime" class="text-danger"></span>
            </div>
            <div class="col-md-6 mb-3">
                <label asp-for="EndTime" class="form-label">End time</label>
                <input asp-for="EndTime" type="time" class="form-control" />
                <span asp-validation-for="EndTime" class="text-danger"></span>
            </div>
        </div>

        <div class="form-actions">
            <button type="submit" class="btn btn-primary">Save changes</button>
            <a asp-action="Index" class="btn btn-secondary">Cancel</a>
        </div>
    </form>
</div>
