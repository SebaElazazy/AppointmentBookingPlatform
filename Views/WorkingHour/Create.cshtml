@model AppointmentsManagementSystem.Models.WorkingHour
@{
      Layout = User.IsInRole("Admin") ? "_AdminLayout" : "_Layout";
    ViewData["Title"] = "Add working hours";
}

<a asp-action="Index" class="back-link">&larr; Back to working hours</a>

<div class="page-header">
    <div>
        <h1>Add working hours</h1>
        <p>Set a recurring day and time range for a staff member.</p>
    </div>
</div>

<div class="form-card">
    <form asp-action="Create">
        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

        <div class="mb-3">
            <label class="form-label">Staff member</label>
            <select name="StaffId" class="form-select" asp-items="ViewBag.StaffId">
                <option value="">-- Select staff --</option>
            </select>
            <span asp-validation-for="StaffId" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="DayOfWeek" class="form-label">Day of week</label>
            <select asp-for="DayOfWeek" class="form-select" asp-items="Html.GetEnumSelectList<DayOfWeek>()"></select>
            <span asp-validation-for="DayOfWeek" class="text-danger"></span>
        </div>

        <div class="row">
            <div class="col-md-6 mb-3">
                <label asp-for="StartTime" class="form-label">Start time</label>
                <input asp-for="StartTime" type="time" class="form-control" />
                <span asp-validation-for="StartTime" class="text-danger"></span>
            </div>
            <div class="col-md-6 mb-3">
                <label asp-for="EndTime" class="form-label">End time</label>
                <input asp-for="EndTime" type="time" class="form-control" />
                <span asp-validation-for="EndTime" class="text-danger"></span>
            </div>
        </div>

        <div class="form-actions">
            <button type="submit" class="btn btn-primary">Save working hours</button>
            <a asp-action="Index" class="btn btn-secondary">Cancel</a>
        </div>
    </form>
</div>
