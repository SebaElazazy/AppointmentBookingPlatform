@model AppointmentsManagementSystem.Models.WorkingHour
@{
      Layout = User.IsInRole("Admin") ? "_AdminLayout" : "_Layout";
    ViewData["Title"] = "Working hours details";
}

<a asp-action="Index" class="back-link">&larr; Back to working hours</a>

<div class="page-header">
    <div><h1>@(Model.Staff?.User?.FullName ?? "Staff") &mdash; @Model.DayOfWeek</h1></div>
</div>

<div class="detail-card">
    <div class="detail-row"><span class="k">Staff</span><span class="v">@Model.Staff?.User?.FullName</span></div>
    <div class="detail-row"><span class="k">Day</span><span class="v">@Model.DayOfWeek</span></div>
    <div class="detail-row"><span class="k">Hours</span><span class="v">@Model.StartTime.ToString(@"hh\:mm") &ndash; @Model.EndTime.ToString(@"hh\:mm")</span></div>

    @if (User.IsInRole("Admin"))
    {
        <div class="form-actions">
            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">Edit</a>
            <a asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-secondary" style="color:var(--danger) !important;">Delete</a>
        </div>
    }
</div>
