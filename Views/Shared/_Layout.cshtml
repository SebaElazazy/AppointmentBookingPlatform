

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - AppointmentsManagementSystem</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,500;9..144,600;9..144,700&family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/AppointmentsManagementSystem.styles.css" asp-append-version="true" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=El+Messiri:wght@500;600;700&family=IBM+Plex+Sans:wght@400;500;600&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="~/css/appointo.css">
    <style>
        html, body {
            height: 100%;
            margin: 0;
        }
        body {
            display: flex;
            flex-direction: column;
            min-height: 100vh;
            background-color: #f8fafc;
        }
        .main-content {
            flex: 1 0 auto;
        }
        .custom-footer {
            flex-shrink: 0;
            background-color: #0f172a;
            color: #94a3b8;
            font-size: 0.95rem;
        }
        .custom-footer h5 {
            color: #f8fafc;
            font-weight: 600;
            font-size: 1.1rem;
            margin-bottom: 1.2rem;
        }
        .custom-footer a {
            color: #94a3b8;
            text-decoration: none;
            transition: color 0.2s ease;
        }
        .custom-footer a:hover {
            color: #38bdf8;
        }
        .footer-slant {
            overflow: hidden;
            line-height: 0;
        }
        .footer-slant svg {
            position: relative;
            display: block;
            width: calc(100% + 1.3px);
            height: 50px;
        }
    </style>
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container-fluid">
                <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">Appointo</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item"><a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="Index">Home</a></li>
                        <li class="nav-item"><a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a></li>
                        <li class="nav-item"><a class="nav-link text-dark" asp-controller="Dashboard" asp-action="Index">Dashboard</a></li>
                        <li class="nav-item"><a class="nav-link text-dark" asp-controller="Services" asp-action="Index">Services</a></li>
                        <li class="nav-item"><a class="nav-link text-dark" asp-controller="Staff" asp-action="Index">Staff</a></li>
                        <li class="nav-item"><a class="nav-link text-dark" asp-controller="WorkingHour" asp-action="Index">Working Hours</a></li>
                        <li class="nav-item"><a class="nav-link text-dark" asp-controller="AvailabilityException" asp-action="Index">Exceptions</a></li>
                        <li class="nav-item"><a class="nav-link text-dark" asp-controller="Appointment" asp-action="Index">Appointments</a></li>
                    </ul>
                    <partial name="_LoginPartial" />
                </div>
            </div>
        </nav>
    </header>

    <div class="main-content container py-4">
        <main role="main">
            @RenderBody()
        </main>
    </div>

    <footer class="custom-footer">
        <div class="footer-slant" style="background: transparent;">
            <svg data-name="Layer 1" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1200 120" preserveAspectRatio="none" style="fill: #0f172a;">
                <path d="M1200 120L0 16.48V0h1200v120z"></path>
            </svg>
        </div>

        <div class="container pb-5 pt-3">
            <div class="row g-4 justify-content-between">
                <!-- العمود الأول -->
                <div class="col-lg-4 col-md-6">
                    <a class="navbar-brand fw-bold fs-3 text-white d-block mb-3" asp-controller="Home" asp-action="Index">
                        App<span style="color: #38bdf8;">ointo</span>
                    </a>
                    <p class="text-secondary small mb-4">
                        Smart appointment and resource management system designed to streamline your business workflow with elegance and precision.
                    </p>
                    <div class="d-flex gap-3 fs-5">
                        <a href="#" aria-label="Facebook"><i class="bi bi-facebook"></i></a>
                        <a href="#" aria-label="Twitter"><i class="bi bi-twitter-x"></i></a>
                        <a href="#" aria-label="LinkedIn"><i class="bi bi-linkedin"></i></a>
                        <a href="#" aria-label="Instagram"><i class="bi bi-instagram"></i></a>
                    </div>
                </div>

                <!-- العمود الثاني -->
                <div class="col-lg-3 col-md-6">
                    <h5>Quick Links</h5>
                    <ul class="list-unstyled d-flex flex-column gap-2 mb-0">
                        <li><a asp-controller="Home" asp-action="Index">Home</a></li>
                        <li><a asp-controller="Dashboard" asp-action="Index">Dashboard</a></li>
                        <li><a asp-controller="Services" asp-action="Index">Services</a></li>
                        <li><a asp-controller="Appointment" asp-action="Index">Appointments</a></li>
                        <li><a asp-controller="Home" asp-action="Privacy">Privacy Policy</a></li>
                    </ul>
                </div>

                <!-- العمود الثالث -->
                <div class="col-lg-4 col-md-12">
                    <h5>Contact Us</h5>
                    <ul class="list-unstyled d-flex flex-column gap-3 mb-0 text-secondary small">
                        <li class="d-flex align-items-start gap-2">
                            <span class="text-white">📍</span>
                            <span>123 Business Avenue, Tech District, Arish, Egypt</span>
                        </li>
                        <li class="d-flex align-items-center gap-2">
                            <span class="text-white">📞</span>
                            <span>+20 123 456 7890</span>
                        </li>
                        <li class="d-flex align-items-center gap-2">
                            <span class="text-white">✉️</span>
                            <span>support@appointo.com</span>
                        </li>
                    </ul>
                </div>
            </div>

            <hr class="border-secondary my-4 opacity-25">

            <div class="d-flex flex-wrap justify-content-between align-items-center small text-secondary">
                <span>&copy; @DateTime.Now.Year Appointo - AppointmentsManagementSystem. All rights reserved.</span>
                <div class="d-flex gap-4">
                    <a href="#">Terms of Service</a>
                    <a asp-controller="Home" asp-action="Privacy">Privacy Policy</a>
                </div>
            </div>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>